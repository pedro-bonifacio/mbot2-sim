<!-- Typed variables + functions in Open Roberta's program format (sibling blocks in
     statements, mutations as Open Roberta writes them). Used by scripts/variables-check.mjs.
     Expected serial output: 12996, then 114. -->
<block_set xmlns="http://de.fhg.iais.roberta.blockly" robottype="mbot2" xmlversion="3.1" description="" tags="">
  <instance x="40" y="40">
    <block type="robControls_start" id="start" intask="true" deletable="false">
      <mutation declare="true"></mutation>
      <field name="DEBUG">TRUE</field>
      <statement name="ST">
        <block type="robGlobalVariables_declare" id="g1" intask="true" deletable="false" movable="false">
          <mutation next="true" declaration_type="Number"></mutation>
          <field name="VAR">contador</field>
          <field name="TYPE">Number</field>
          <value name="VALUE"><block type="math_number" intask="true"><field name="NUM">0</field></block></value>
        </block>
        <block type="robGlobalVariables_declare" id="g2" intask="true" deletable="false" movable="false">
          <mutation next="false" declaration_type="Array_Number"></mutation>
          <field name="VAR">lista</field>
          <field name="TYPE">Array_Number</field>
          <value name="VALUE">
            <block type="robLists_create_with" intask="true">
              <mutation items="3" list_type="Number"></mutation>
              <field name="LIST_TYPE">Number</field>
              <value name="ADD0"><block type="math_number" intask="true"><field name="NUM">3</field></block></value>
              <value name="ADD1"><block type="math_number" intask="true"><field name="NUM">4</field></block></value>
              <value name="ADD2"><block type="math_number" intask="true"><field name="NUM">5</field></block></value>
            </block>
          </value>
        </block>
      </statement>
    </block>
    <block type="robControls_forEach" intask="true">
      <mutation list_type="Number"></mutation>
      <field name="TYPE">Number</field>
      <field name="VAR">item</field>
      <value name="LIST"><block type="variables_get" intask="true"><mutation datatype="Array_Number"></mutation><field name="VAR">lista</field></block></value>
      <statement name="DO">
        <block type="variables_set" intask="true">
          <mutation datatype="Number"></mutation>
          <field name="VAR">contador</field>
          <value name="VALUE">
            <block type="math_arithmetic" intask="true">
              <field name="OP">ADD</field>
              <value name="A"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">contador</field></block></value>
              <value name="B">
                <block type="robProcedures_callreturn" intask="true">
                  <mutation name="dobro" output_type="Number"><arg name="x" type="Number"></arg></mutation>
                  <value name="ARG0"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">item</field></block></value>
                </block>
              </value>
            </block>
          </value>
        </block>
      </statement>
    </block>
    <block type="robProcedures_callnoreturn" intask="true">
      <mutation name="quadrado"><arg name="lado" type="Number"></arg></mutation>
      <value name="ARG0"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">contador</field></block></value>
    </block>
    <block type="robActions_serial_print" intask="true">
      <value name="OUT"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">contador</field></block></value>
    </block>
  </instance>
  <instance x="400" y="40">
    <block type="robProcedures_defnoreturn" intask="true">
      <mutation declare="true"></mutation>
      <field name="NAME">quadrado</field>
      <statement name="ST">
        <block type="robLocalVariables_declare" intask="true" deletable="false" movable="false">
          <mutation next="false" declaration_type="Number"></mutation>
          <field name="VAR">lado</field>
          <field name="TYPE">Number</field>
        </block>
      </statement>
      <statement name="STACK">
        <block type="robActions_serial_print" intask="true">
          <value name="OUT">
            <block type="math_arithmetic" intask="true">
              <field name="OP">MULTIPLY</field>
              <value name="A"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">lado</field></block></value>
              <value name="B"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">lado</field></block></value>
            </block>
          </value>
        </block>
      </statement>
    </block>
  </instance>
  <instance x="400" y="300">
    <block type="robProcedures_defreturn" intask="true">
      <mutation declare="true" return_type="Number"></mutation>
      <field name="NAME">dobro</field>
      <field name="TYPE">Number</field>
      <repetitions>
        <statement name="ST">
          <block type="robLocalVariables_declare" intask="true" deletable="false" movable="false">
            <mutation next="false" declaration_type="Number"></mutation>
            <field name="VAR">x</field>
            <field name="TYPE">Number</field>
          </block>
        </statement>
        <statement name="STACK">
          <block type="robProcedures_ifreturn" intask="true">
            <mutation value="1" return_type="Number"></mutation>
            <value name="CONDITION">
              <block type="logic_compare" intask="true">
                <field name="OP">GT</field>
                <value name="A"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">x</field></block></value>
                <value name="B"><block type="math_number" intask="true"><field name="NUM">4</field></block></value>
              </block>
            </value>
            <value name="VALUE"><block type="math_number" intask="true"><field name="NUM">100</field></block></value>
          </block>
        </statement>
        <value name="RETURN">
          <block type="math_arithmetic" intask="true">
            <field name="OP">MULTIPLY</field>
            <value name="A"><block type="variables_get" intask="true"><mutation datatype="Number"></mutation><field name="VAR">x</field></block></value>
            <value name="B"><block type="math_number" intask="true"><field name="NUM">2</field></block></value>
          </block>
        </value>
      </repetitions>
    </block>
  </instance>
</block_set>
