{
  "_doc": "Headless simulator tests (npm run sim:test). pose = relative to the spawn: forward/right cm, turned degrees (+ = right); tolerance 0.5 cm / 1 deg. Only listed fields are checked. seed = the program's random-number seed (default 1). consoleWarnings = every warning the program prints, in order.",
  "tests": [
    {
      "name": "Open Roberta export 01-simples (waits for key A)",
      "program": "reference_openroberta/export-samples/openroberta/01-simples.xml",
      "keys": [
        {
          "key": "A",
          "at": 0.5
        }
      ],
      "maxSeconds": 30,
      "expect": {
        "status": "finished",
        "pose": {
          "forward": 20,
          "right": 76.1,
          "turned": 90
        },
        "display": [
          "0 Ola"
        ],
        "leds": [
          "#33cc00",
          "#33cc00",
          "#33cc00",
          "#33cc00",
          "#33cc00"
        ]
      }
    },
    {
      "name": "01-simples without key A keeps waiting",
      "program": "reference_openroberta/export-samples/openroberta/01-simples.xml",
      "maxSeconds": 5,
      "expect": {
        "status": "timeout",
        "pose": {
          "forward": 0,
          "right": 0,
          "turned": 0
        }
      }
    },
    {
      "name": "teste-1: typed globals, for-each over a list",
      "program": "scripts/fixtures/teste-1-variaveis.xml",
      "expect": {
        "status": "finished",
        "warnings": 0,
        "pose": {
          "forward": 20,
          "right": 20,
          "turned": -90
        },
        "display": [
          "0 mBot volta 3",
          "1 terminou: true"
        ]
      }
    },
    {
      "name": "teste-2: function with a parameter (two squares)",
      "program": "scripts/fixtures/teste-2-funcao.xml",
      "expect": {
        "status": "finished",
        "warnings": 0,
        "pose": {
          "forward": 0,
          "right": 0,
          "turned": 0
        },
        "distance": 240,
        "display": [
          "0 Feito"
        ]
      }
    },
    {
      "name": "teste-3: return values; follows the walls clockwise",
      "program": "scripts/fixtures/teste-3-retorno.xml",
      "maxSeconds": 30,
      "expect": {
        "status": "timeout",
        "warnings": 0,
        "pose": {
          "forward": 6.5,
          "right": 28.6,
          "turned": -90
        },
        "display": [
          "0 42"
        ]
      }
    },
    {
      "name": "teste-4: scope errors warn and stop the run",
      "program": "scripts/fixtures/teste-4-erros.xml",
      "expect": {
        "status": "error",
        "error": "passos is not defined",
        "warnings": 4,
        "pose": {
          "forward": 10,
          "right": 0,
          "turned": 0
        }
      }
    },
    {
      "name": "collision: front bumper stops at the wall face (17.5 cm footprint, not a point)",
      "program": "scripts/fixtures/collision/frente-parede.xml",
      "expect": {
        "status": "collision",
        "pose": {
          "forward": 95.6,
          "right": 0,
          "turned": 0
        }
      }
    },
    {
      "name": "collision: rear bumper stops at the wall face when reversing",
      "program": "scripts/fixtures/collision/tras-parede.xml",
      "expect": {
        "status": "collision",
        "pose": {
          "forward": -8.2,
          "right": 0,
          "turned": 0
        }
      }
    },
    {
      "name": "collision: a rear corner hits the wall while turning on the spot",
      "program": "scripts/fixtures/collision/canto-rodar.xml",
      "expect": {
        "status": "collision",
        "pose": {
          "forward": -7,
          "right": 0,
          "turned": 12.4
        }
      }
    },
    {
      "name": "collision: turning on the spot with room to spare is free",
      "program": "scripts/fixtures/collision/rodar-livre.xml",
      "expect": {
        "status": "finished",
        "pose": {
          "forward": -4,
          "right": 0,
          "turned": 90
        }
      }
    },
    {
      "name": "random blocks: seed 1 gives the same numbers every run",
      "program": "scripts/fixtures/aleatorio.xml",
      "seed": 1,
      "expect": {
        "status": "finished",
        "display": [
          "0 63",
          "1 0.002735721180215478"
        ]
      }
    },
    {
      "name": "random blocks: another seed gives other numbers",
      "program": "scripts/fixtures/aleatorio.xml",
      "seed": 7,
      "expect": {
        "status": "finished",
        "display": [
          "0 2",
          "1 0.06195825757458806"
        ]
      }
    },
    {
      "name": "speeds above 200 RPM run at 200 and warn once per run",
      "program": "scripts/fixtures/rpm-acima-do-limite.xml",
      "expect": {
        "status": "finished",
        "pose": {
          "forward": 50,
          "right": -20,
          "turned": 90
        },
        "consoleWarnings": [
          "⚠ Os motores do mBot 2 só vão até 200 RPM. Pediste 500 RPM: o robô anda a 200."
        ]
      }
    }
  ]
}
