{
  "_doc": "When a run passes or fails (src/levels/referee.js). Each case runs `code` on a level (seed 1 unless `seed`), with `patch` merged over the level file, and expects the verdict's `passed` and `reason`. Run by npm run levels:check.",
  "cases": [
    { "name": "sensor loop that never ends passes once the robot has stood still 2 s",
      "level": "04-01",
      "code": "robotAPI.drive(\"FOREWARD\", 30);\nwhile (true) {\n  if (robotAPI.ultrasonic() < 10) {\n    robotAPI.drive_stop();\n  }\n}",
      "expect": { "passed": true, "reason": "settled" } },
    { "name": "settle: never — the same loop is judged at the time limit",
      "level": "04-01", "patch": {"settle": "never", "timeLimit": 12},
      "code": "robotAPI.drive(\"FOREWARD\", 30);\nwhile (true) {\n  if (robotAPI.ultrasonic() < 10) {\n    robotAPI.drive_stop();\n  }\n}",
      "expect": { "passed": true, "reason": "timeLimit" } },
    { "name": "stopped too far from the wall in a forever loop fails after 5 s still, not at the limit",
      "level": "04-01",
      "code": "robotAPI.drive(\"FOREWARD\", 30);\nwhile (true) {\n  if (robotAPI.ultrasonic() < 60) {\n    robotAPI.drive_stop();\n  }\n}",
      "expect": { "passed": false, "reason": "stalled", "beforeS": 20 } },
    { "name": "stall: never — the same program waits for the time limit",
      "level": "04-01", "patch": {"stall": "never"},
      "code": "robotAPI.drive(\"FOREWARD\", 30);\nwhile (true) {\n  if (robotAPI.ultrasonic() < 60) {\n    robotAPI.drive_stop();\n  }\n}",
      "expect": { "passed": false, "reason": "timeLimit" } },
    { "name": "a robot that has not moved yet does not stall (it may be waiting for a key)",
      "level": "04-01", "patch": {"timeLimit": 10},
      "code": "while (true) {}",
      "expect": { "passed": false, "reason": "timeLimit" } },
    { "name": "touching a wall fails even when noCollision is not a goal and the other goals hold",
      "level": "04-01", "patch": {"goals": [{"reachZone": {"zone": "perto", "probe": "front"}}]},
      "code": "robotAPI.drive(\"FOREWARD\", 30);\nwhile (true) {}",
      "expect": { "passed": false, "reason": "collision" } },
    { "name": "a number goal finds the number inside text, with a decimal comma (\"Riscas: 3,0\")",
      "level": "07-01", "seed": 12,
      "code": "robotAPI.println(\"Riscas: 3,0\");",
      "expect": { "passed": true, "reason": "ended" } },
    { "name": "display_text cells count for displayShows as well as printed lines",
      "level": "04-05", "seed": 7,
      "code": "robotAPI.display_text(\"PERTO\", 0, 3);",
      "expect": { "passed": true, "reason": "ended" } },
    { "name": "sequence: a state already on screen does not count again for a later step (red, wait, red)",
      "level": "02-04",
      "code": "robotAPI.led_on(\"ALL\", \"#33cc00\");\nrobotAPI.wait_ms(500);\nrobotAPI.led_on(\"ALL\", \"#ffff00\");\nrobotAPI.wait_ms(500);\nrobotAPI.led_on(\"ALL\", \"#ffff00\");",
      "expect": { "passed": false, "reason": "finished" } },
    { "name": "sequence: LEDs and display of different kinds may change in the same tick",
      "level": "02-04", "patch": {"goals": [{"sequence": {"steps": [{"leds": "green"}, {"display": "Verde"}, {"leds": "red"}]}}]},
      "code": "robotAPI.led_on(\"ALL\", \"#33cc00\");\nrobotAPI.println(\"Verde\");\nrobotAPI.wait_ms(500);\nrobotAPI.led_on(\"ALL\", \"#cc0000\");",
      "expect": { "passed": true, "reason": "ended" } },
    { "name": "stayIn: leaving the zone fails at once, before the time limit",
      "level": "05-08",
      "code": "robotAPI.drive(\"FOREWARD\", 40);\nwhile (true) {}",
      "expect": { "passed": false, "reason": "leftZone", "beforeS": 10 } },
    { "name": "on a board, driving off the edge fails (no wall there: no collision)",
      "level": "05-08", "patch": { "goals": ["noCollision"] },
      "code": "robotAPI.drive(\"FOREWARD\", 40);\nwhile (true) {}",
      "expect": { "passed": false, "reason": "offBoard" } },
    { "name": "on a board, the ultrasonic sees nothing beyond the edge",
      "level": "05-08", "patch": { "goals": [{ "displayShows": { "text": "300" } }] },
      "code": "robotAPI.println(robotAPI.ultrasonic());",
      "expect": { "passed": true, "reason": "ended" } }
  ]
}
