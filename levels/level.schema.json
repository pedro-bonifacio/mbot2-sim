{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mbot2-sim/level.schema.json",
  "title": "mBot 2 simulator level",
  "description": "One level of the mBot 2 simulator. Reference: docs/LEVEL_FORMAT.md. Positions are in cm (x → right, y → down, origin top-left); a number field may also be an expression of variant parameters, e.g. \"wallX - 10\".",
  "type": "object",
  "required": ["id", "world", "title", "objective", "goals", "solution"],
  "additionalProperties": false,
  "definitions": {
    "num": {
      "description": "cm, degrees or seconds: a number, or an expression of variant parameters (+ - * / and parentheses)",
      "type": ["number", "string"]
    },
    "colour": {
      "description": "One of the quad RGB sensor's 8 colours (no orange; magenta/cyan #00ffff are reserved), or the name of a variant parameter holding one",
      "type": "string"
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"$ref": "#/definitions/num", "description": "left edge, cm"},
        "y": {"$ref": "#/definitions/num", "description": "top edge, cm"},
        "w": {"$ref": "#/definitions/num"},
        "h": {"$ref": "#/definitions/num"},
        "angle": {"$ref": "#/definitions/num", "description": "rotation about the centre, degrees clockwise"}
      }
    },
    "circle": {
      "type": "object",
      "required": ["cx", "cy", "r"],
      "properties": {
        "cx": {"$ref": "#/definitions/num"},
        "cy": {"$ref": "#/definitions/num"},
        "r": {"$ref": "#/definitions/num"}
      }
    },
    "shape": {"oneOf": [{"$ref": "#/definitions/rect"}, {"$ref": "#/definitions/circle"}]},
    "zoneRef": {
      "type": "object",
      "required": ["zone"],
      "additionalProperties": false,
      "properties": {
        "zone": {"type": "string"},
        "probe": {"enum": ["centre", "front"], "description": "robot centre (default) or middle of the front bumper"},
        "label": {"type": "string", "description": "PT-PT text shown instead of the default"}
      }
    },
    "program": {"type": "string", "description": "ES5 code calling robotAPI, as the code generator writes it"},
    "when": {
      "$ref": "#/definitions/num",
      "description": "leave this out of the variant when the expression is 0, e.g. \"stripes >= 4\""
    },
    "text": {
      "type": "string",
      "description": "text; {name} puts in a text parameter, {expression} a number, e.g. \"{word}\""
    },
    "mapItems": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 2,
        "properties": {
          "wall": {"$ref": "#/definitions/shape"},
          "box": {"$ref": "#/definitions/shape"},
          "patch": {
            "allOf": [
              {"$ref": "#/definitions/shape"},
              {
                "type": "object",
                "required": ["colour"],
                "properties": {"colour": {"$ref": "#/definitions/colour"}}
              }
            ]
          },
          "line": {
            "type": "object",
            "required": ["points"],
            "properties": {
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/definitions/num"}}
              },
              "width": {"$ref": "#/definitions/num", "description": "cm (default 2)"},
              "smooth": {
                "type": "boolean",
                "description": "a smooth curve through the points instead of straight segments"
              },
              "colour": {"$ref": "#/definitions/colour"}
            }
          },
          "arc": {
            "type": "object",
            "required": ["cx", "cy", "r"],
            "properties": {
              "cx": {"$ref": "#/definitions/num"},
              "cy": {"$ref": "#/definitions/num"},
              "r": {"$ref": "#/definitions/num"},
              "from": {"$ref": "#/definitions/num", "description": "degrees clockwise from east"},
              "to": {"$ref": "#/definitions/num"},
              "width": {"$ref": "#/definitions/num"},
              "colour": {"$ref": "#/definitions/colour"}
            }
          },
          "when": {
            "$ref": "#/definitions/num",
            "description": "leave this out of the variant when the expression is 0, e.g. \"stripes >= 4\""
          },
          "maze": {
            "type": "object",
            "required": ["cols", "rows", "cell"],
            "additionalProperties": false,
            "description": "a maze generated anew for each variant (decision 0005): tape lines between cell centres, or walls on the closed sides",
            "properties": {
              "cols": {"$ref": "#/definitions/num"},
              "rows": {"$ref": "#/definitions/num"},
              "cell": {"$ref": "#/definitions/num", "description": "cell size, cm"},
              "x": {"$ref": "#/definitions/num", "description": "top-left corner, cm"},
              "y": {"$ref": "#/definitions/num"},
              "start": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"$ref": "#/definitions/num"},
                "description": "[col, row] where the maze is grown from (default [0, 0])"
              },
              "loops": {
                "$ref": "#/definitions/num",
                "description": "extra openings: 0 = exactly one path between any two cells"
              },
              "style": {"enum": ["tape", "walls"]},
              "width": {"$ref": "#/definitions/num", "description": "tape width (default 2)"},
              "thickness": {"$ref": "#/definitions/num", "description": "wall thickness (default 2)"},
              "colour": {"$ref": "#/definitions/colour"}
            }
          },
          "scatter": {
            "type": "object",
            "required": ["count", "w", "h", "area"],
            "additionalProperties": false,
            "description": "count boxes (or patches, with a colour) placed at random for each variant, gap cm apart",
            "properties": {
              "count": {"$ref": "#/definitions/num"},
              "w": {"$ref": "#/definitions/num"},
              "h": {"$ref": "#/definitions/num"},
              "area": {
                "type": "object",
                "required": ["x", "y", "w", "h"],
                "properties": {
                  "x": {"$ref": "#/definitions/num"},
                  "y": {"$ref": "#/definitions/num"},
                  "w": {"$ref": "#/definitions/num"},
                  "h": {"$ref": "#/definitions/num"}
                }
              },
              "gap": {
                "$ref": "#/definitions/num",
                "description": "minimum free space between items, cm (the area holds the items whole)"
              },
              "keepClear": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": {
                    "x": {"$ref": "#/definitions/num"},
                    "y": {"$ref": "#/definitions/num"},
                    "w": {"$ref": "#/definitions/num"},
                    "h": {"$ref": "#/definitions/num"}
                  }
                },
                "description": "rectangles nothing may overlap (spawn, finish)"
              },
              "colour": {"$ref": "#/definitions/colour"}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/definitions/shape"},
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string", "description": "PT-PT name used in messages"},
              "when": {"$ref": "#/definitions/when"}
            }
          }
        ]
      }
    },
    "spawn": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"$ref": "#/definitions/num"},
        "y": {"$ref": "#/definitions/num"},
        "heading": {"$ref": "#/definitions/num", "description": "degrees clockwise from east: 0 →, 90 ↓, 180 ←, -90 ↑"}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{2}-\\d{2}$", "description": "WW-NN, e.g. \"04-01\""},
    "world": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["core", "bonus", "challenge", "evaluation"]},
    "title": {"type": "string"},
    "objective": {"type": "string", "description": "PT-PT: what to do, shown to the student"},
    "briefing": {"type": "string"},
    "starter": {
      "type": "string",
      "description": "Program the level opens with (Blockly XML as saved by the sim, or an Open Roberta export), e.g. a broken program to fix. levels:check requires it to fail at least one seed."
    },
    "concepts": {"type": "array", "items": {"type": "string"}},
    "assumes": {"type": "array", "items": {"type": "string"}},
    "toolbox": {"enum": ["beginner", "expert"]},
    "timeLimit": {"$ref": "#/definitions/num", "description": "simulated seconds (default 60)"},
    "settle": {
      "anyOf": [{"$ref": "#/definitions/num"}, {"const": "never"}],
      "description": "pass once every goal holds and the robot has stood still this long (default 2 s); never = only when the program ends or at the time limit"
    },
    "stall": {
      "anyOf": [{"$ref": "#/definitions/num"}, {"const": "never"}],
      "description": "fail once the robot, having moved, stands still this long with a goal unmet (default 5 s); never = wait for the time limit"
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["min", "max"],
                "additionalProperties": false,
                "properties": {
                  "min": {"type": "number"},
                  "max": {"type": "number"},
                  "step": {"type": "number", "exclusiveMinimum": 0}
                }
              },
              {
                "type": "object",
                "required": ["choices"],
                "additionalProperties": false,
                "properties": {
                  "choices": {
                    "type": "array",
                    "minItems": 1,
                    "description": "pick one: a number, a text (colour name, word) or a case {name: value, …} whose keys all become parameters",
                    "items": {
                      "anyOf": [
                        {"type": "number"},
                        {"type": "string"},
                        {
                          "type": "object",
                          "minProperties": 1,
                          "additionalProperties": {"type": ["number", "string"]}
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "seeds": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 1,
          "description": "the ★★ test set; the first is the one the student sees first"
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "properties": {"w": {"$ref": "#/definitions/num"}, "h": {"$ref": "#/definitions/num"}}
        },
        "board": {
          "enum": [true, 1, 2, 3],
          "description": "a course board of 1–3 K-line sheets (decision 0018): default size 100 × 70 (true or 1), 140 × 100 (2), 210 × 100 (3); no wall at the edge (the ultrasonic sees nothing beyond it), the robot's centre leaving it fails"
        },
        "border": {"type": "boolean", "description": "1 cm wall around the arena (default true; false on a board)"},
        "items": {"$ref": "#/definitions/mapItems"}
      }
    },
    "spawn": {"$ref": "#/definitions/spawn"},
    "zones": {"$ref": "#/definitions/zones"},
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"enum": ["noCollision"]},
          {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "reachZone": {"$ref": "#/definitions/zoneRef"},
              "robotStoppedIn": {"$ref": "#/definitions/zoneRef"},
              "noCollision": {"type": ["object", "null"], "properties": {"label": {"type": "string"}}},
              "displayShows": {
                "type": "object",
                "additionalProperties": false,
                "description": "at the end: a display line equals text, or holds a number within tolerance",
                "properties": {
                  "text": {"$ref": "#/definitions/text"},
                  "any": {"const": true, "description": "any text but the toolbox default \"Hallo\""},
                  "number": {
                    "$ref": "#/definitions/num",
                    "description": "expected number: variant parameters and the run's drivenCm (cm the robot travelled) and movingS (s it was moving)"
                  },
                  "tolerance": {"$ref": "#/definitions/num", "description": "± allowed (default 0)"},
                  "row": {"type": "integer"},
                  "label": {"type": "string"}
                },
                "oneOf": [{"required": ["text"]}, {"required": ["number"]}, {"required": ["any"]}]
              },
              "ledColour": {
                "type": "object",
                "required": ["colour"],
                "additionalProperties": false,
                "properties": {"colour": {"$ref": "#/definitions/colour"}, "label": {"type": "string"}}
              },
              "tonePlayed": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "description": "any time: a tone was played",
                "properties": {
                  "frequency": {"$ref": "#/definitions/num", "description": "Hz; omit for any tone"},
                  "duration": {"$ref": "#/definitions/num", "description": "ms (± 1); omit for any length"},
                  "tolerance": {"$ref": "#/definitions/num", "description": "± Hz (default 1)"},
                  "label": {"type": "string"}
                }
              },
              "sequence": {
                "type": "object",
                "required": ["steps"],
                "additionalProperties": false,
                "description": "any time: these states/events happened in this order",
                "properties": {
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "display": {"$ref": "#/definitions/text"},
                        "leds": {
                          "description": "all five LEDs in this colour, or off",
                          "anyOf": [{"$ref": "#/definitions/colour"}, {"const": "off"}]
                        },
                        "tone": {"$ref": "#/definitions/num", "description": "Hz"},
                        "tolerance": {"$ref": "#/definitions/num"},
                        "zone": {"type": "string"},
                        "probe": {"enum": ["centre", "front"]}
                      }
                    }
                  },
                  "times": {
                    "$ref": "#/definitions/num",
                    "description": "the steps repeated this many times (default 1)"
                  },
                  "label": {"type": "string"}
                }
              },
              "stayIn": {
                "$ref": "#/definitions/zoneRef",
                "description": "throughout: never leave the zone; holds at the time limit (the robot must have moved)"
              }
            }
          }
        ]
      }
    },
    "solution": {"$ref": "#/definitions/program", "description": "must pass every seed (★★)"},
    "antiSolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "code"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "why": {"type": "string"}, "code": {"$ref": "#/definitions/program"}}
      },
      "description": "tempting but wrong programs; each must fail at least one seed"
    },
    "challenge": {
      "type": "object",
      "description": "★★★ (decision 0019), judged on a program that earns ★★. At least one of maxBlocks / maxSeconds.",
      "required": ["solution"],
      "anyOf": [{"required": ["maxBlocks"]}, {"required": ["maxSeconds"]}],
      "additionalProperties": false,
      "properties": {
        "maxBlocks": {"type": "integer", "minimum": 1, "description": "at most this many blocks (the start block, numbers, texts, colours, true/false and comments do not count)"},
        "maxSeconds": {"type": "number", "exclusiveMinimum": 0, "description": "every variant passes within this many simulated seconds"},
        "label": {"type": "string", "description": "PT-PT wording instead of the generated one"},
        "solution": {"type": "string", "description": "Blockly XML (as Guardar programa saves it) that meets the challenge on every seed; checked by levels:check, never sent to the browser"}
      }
    },
    "layouts": {
      "type": "object",
      "description": "hand-drawn alternatives, one per variant, picked by the text parameter `layout` (e.g. layout: { choices: [oval, gancho] }). Each adds items and zones and may set the spawn.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {"$ref": "#/definitions/mapItems"},
          "zones": {"$ref": "#/definitions/zones"},
          "spawn": {"$ref": "#/definitions/spawn"}
        }
      }
    }
  }
}
