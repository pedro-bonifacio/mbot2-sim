{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mbot2-sim/level.schema.json",
  "title": "mBot 2 simulator level",
  "description": "One level of the mBot 2 simulator. Reference: docs/LEVEL_FORMAT.md. Positions are in cm (x → right, y → down, origin top-left); a number field may also be an expression of variant parameters, e.g. \"wallX - 10\".",
  "type": "object",
  "required": ["id", "world", "title", "objective", "spawn", "goals", "solution"],
  "additionalProperties": false,
  "definitions": {
    "num": { "description": "cm, degrees or seconds: a number, or an expression of variant parameters (+ - * / and parentheses)", "type": ["number", "string"] },
    "colour": { "description": "One of the quad RGB sensor's 8 colours (no orange; magenta/cyan #00ffff are reserved)", "enum": ["red", "yellow", "green", "cyan", "blue", "purple", "white", "black"] },
    "rect": {
      "type": "object", "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "$ref": "#/definitions/num", "description": "left edge, cm" }, "y": { "$ref": "#/definitions/num", "description": "top edge, cm" },
        "w": { "$ref": "#/definitions/num" }, "h": { "$ref": "#/definitions/num" },
        "angle": { "$ref": "#/definitions/num", "description": "rotation about the centre, degrees clockwise" }
      }
    },
    "circle": {
      "type": "object", "required": ["cx", "cy", "r"],
      "properties": { "cx": { "$ref": "#/definitions/num" }, "cy": { "$ref": "#/definitions/num" }, "r": { "$ref": "#/definitions/num" } }
    },
    "shape": { "oneOf": [ { "$ref": "#/definitions/rect" }, { "$ref": "#/definitions/circle" } ] },
    "zoneRef": {
      "type": "object", "required": ["zone"], "additionalProperties": false,
      "properties": {
        "zone": { "type": "string" },
        "probe": { "enum": ["centre", "front"], "description": "robot centre (default) or middle of the front bumper" },
        "label": { "type": "string", "description": "PT-PT text shown instead of the default" }
      }
    },
    "program": { "type": "string", "description": "ES5 code calling robotAPI, as the code generator writes it" }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{2}-\\d{2}$", "description": "WW-NN, e.g. \"04-01\"" },
    "world": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["core", "bonus", "challenge", "evaluation"] },
    "title": { "type": "string" },
    "objective": { "type": "string", "description": "PT-PT: what to do, shown to the student" },
    "briefing": { "type": "string" },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "assumes": { "type": "array", "items": { "type": "string" } },
    "toolbox": { "enum": ["beginner", "expert"] },
    "timeLimit": { "$ref": "#/definitions/num", "description": "simulated seconds (default 60)" },
    "variants": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "object", "required": ["min", "max"], "additionalProperties": false,
                "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 } } },
              { "type": "object", "required": ["choices"], "additionalProperties": false,
                "properties": { "choices": { "type": "array", "items": { "type": "number" }, "minItems": 1 } } }
            ]
          }
        },
        "seeds": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "description": "the ★★ test set; the first is the one the student sees first" }
      }
    },
    "map": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "size": { "type": "object", "properties": { "w": { "$ref": "#/definitions/num" }, "h": { "$ref": "#/definitions/num" } } },
        "border": { "type": "boolean", "description": "1 cm wall around the arena (default true)" },
        "items": {
          "type": "array",
          "items": {
            "type": "object", "minProperties": 1, "maxProperties": 1,
            "properties": {
              "wall": { "$ref": "#/definitions/shape" },
              "box": { "$ref": "#/definitions/shape" },
              "patch": { "allOf": [ { "$ref": "#/definitions/shape" }, { "type": "object", "required": ["colour"], "properties": { "colour": { "$ref": "#/definitions/colour" } } } ] },
              "line": {
                "type": "object", "required": ["points"],
                "properties": {
                  "points": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/num" } } },
                  "width": { "$ref": "#/definitions/num", "description": "cm (default 2)" },
                  "colour": { "$ref": "#/definitions/colour" }
                }
              },
              "arc": {
                "type": "object", "required": ["cx", "cy", "r"],
                "properties": {
                  "cx": { "$ref": "#/definitions/num" }, "cy": { "$ref": "#/definitions/num" }, "r": { "$ref": "#/definitions/num" },
                  "from": { "$ref": "#/definitions/num", "description": "degrees clockwise from east" }, "to": { "$ref": "#/definitions/num" },
                  "width": { "$ref": "#/definitions/num" }, "colour": { "$ref": "#/definitions/colour" }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "spawn": {
      "type": "object", "required": ["x", "y"], "additionalProperties": false,
      "properties": { "x": { "$ref": "#/definitions/num" }, "y": { "$ref": "#/definitions/num" },
        "heading": { "$ref": "#/definitions/num", "description": "degrees clockwise from east: 0 →, 90 ↓, 180 ←, -90 ↑" } }
    },
    "zones": {
      "type": "array",
      "items": { "allOf": [ { "$ref": "#/definitions/shape" },
        { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "label": { "type": "string", "description": "PT-PT name used in messages" } } } ] }
    },
    "goals": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "enum": ["noCollision"] },
          { "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
            "properties": {
              "reachZone": { "$ref": "#/definitions/zoneRef" },
              "robotStoppedIn": { "$ref": "#/definitions/zoneRef" },
              "noCollision": { "type": ["object", "null"], "properties": { "label": { "type": "string" } } },
              "displayShows": { "type": "object", "required": ["text"], "additionalProperties": false,
                "properties": { "text": { "type": "string" }, "row": { "type": "integer" }, "label": { "type": "string" } } },
              "ledColour": { "type": "object", "required": ["colour"], "additionalProperties": false,
                "properties": { "colour": { "$ref": "#/definitions/colour" }, "label": { "type": "string" } } }
            } }
        ]
      }
    },
    "solution": { "$ref": "#/definitions/program", "description": "must pass every seed (★★)" },
    "antiSolutions": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "code"], "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "why": { "type": "string" }, "code": { "$ref": "#/definitions/program" } } },
      "description": "tempting but wrong programs; each must fail at least one seed"
    }
  }
}
