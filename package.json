{
  "name": "mbot2-sim",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based simulator for Makeblock mBot 2 with an Open Roberta Lab-compatible block editor in PT-PT",
  "license": "MIT",
  "keywords": [
    "mbot2",
    "cyberpi",
    "open-roberta",
    "blockly",
    "robotics-education",
    "simulator"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "or:check": "node scripts/or-fidelity-check.mjs",
    "or:specs": "node scripts/or-generate-specs.mjs",
    "or:codegen": "node scripts/codegen-check.mjs",
    "check": "node scripts/or-fidelity-check.mjs > /dev/null && node scripts/codegen-check.mjs > /dev/null && echo 'all checks passed'"
  },
  "dependencies": {
    "@blockly/field-colour": "5.0.19",
    "blockly": "^11.1.1",
    "js-interpreter": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
